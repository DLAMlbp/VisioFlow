resolver 127.0.0.11 valid=5s ipv6=off;
limit_req_zone $binary_remote_addr zone=integration_api:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=integration_connections:10m;

upstream api_backend {
    zone api_backend 64k;
    server api:8000 resolve;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 30m;

    root /usr/share/nginx/html;
    index index.html;

    location /api/v1/integration/ {
        client_max_body_size 512m;
        limit_req zone=integration_api burst=20 nodelay;
        limit_conn integration_connections 20;
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-API-Key $http_x_api_key;
        proxy_read_timeout 300s;
    }

    location = /api/app/image/filter-requests {
        client_max_body_size 2m;
        limit_req zone=integration_api burst=20 nodelay;
        limit_conn integration_connections 20;
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-API-Key $http_x_api_key;
        proxy_read_timeout 300s;
    }

    location /api/ {
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-API-Key "${API_KEY}";
        proxy_read_timeout 300s;
    }

    location = /health {
        proxy_pass http://api_backend/health;
        proxy_set_header Host $host;
    }

    location = /health/ready {
        proxy_pass http://api_backend/health/ready;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
