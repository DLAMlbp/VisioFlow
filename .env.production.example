APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ALLOWED_ORIGINS=http://47.111.188.85:18081
API_KEY=replace-with-a-long-random-api-key

POSTGRES_USER=image_ai
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=image_ai
DATABASE_URL=postgresql+asyncpg://image_ai:replace-with-a-random-database-password@postgres:5432/image_ai

REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=image_ai_minio
MINIO_ROOT_PASSWORD=replace-with-a-random-minio-password
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://47.111.188.85:19001
S3_ACCESS_KEY=image_ai_minio
S3_SECRET_KEY=replace-with-a-random-minio-password
S3_BUCKET=image-ai
S3_REGION=us-east-1
S3_PRESIGN_EXPIRES_SECONDS=900
MINIO_API_CORS_ALLOW_ORIGIN=http://47.111.188.85:18081

INFERENCE_DEVICE=cpu
INFERENCE_CPU_THREADS=1
AI_TAGGING_ENABLED=true
AI_TAGGING_BASE_URL=https://router.keenlight.ai/v1
AI_TAGGING_MODEL=gpt-5.6-sol
AI_TAGGING_API_KEY=

WEB_PORT=18081
MINIO_PORT=19001
API_IMAGE=ghcr.io/zuixi01/tuxiangshibie-api:<git-sha>
WEB_IMAGE=ghcr.io/zuixi01/tuxiangshibie-web:<git-sha>
