APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ALLOWED_ORIGINS=http://47.111.188.85:8088
TRUSTED_HOSTS=47.111.188.85,localhost,127.0.0.1
API_KEY=
INTEGRATION_API_KEY=
INTEGRATION_MAX_FILES=50
CALLBACK_TIMEOUT_SECONDS=15
CALLBACK_MAX_ATTEMPTS=5
CALLBACK_RETRY_BASE_SECONDS=5
CALLBACK_RECOVERY_INTERVAL_SECONDS=5
CALLBACK_DELIVERY_LEASE_SECONDS=120
CALLBACK_RECOVERY_BATCH_SIZE=100
CALLBACK_SIGNING_SECRET=replace-with-a-random-32-character-secret
CALLBACK_ALLOWED_HOSTS=client.example.com

POSTGRES_USER=image_ai
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=image_ai
DATABASE_URL=postgresql+asyncpg://image_ai:replace-with-a-random-database-password@postgres:5432/image_ai

REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=image_ai_minio
MINIO_ROOT_PASSWORD=replace-with-a-random-minio-password
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://47.111.188.85:19001
S3_ACCESS_KEY=image_ai_minio
S3_SECRET_KEY=replace-with-a-random-minio-password
S3_BUCKET=image-ai
S3_REGION=us-east-1
S3_PRESIGN_EXPIRES_SECONDS=900
MINIO_API_CORS_ALLOW_ORIGIN=http://47.111.188.85:8088

INFERENCE_DEVICE=cpu
INFERENCE_CPU_THREADS=1
AI_TAGGING_ENABLED=true
AI_TAGGING_BASE_URL=https://router.keenlight.ai/v1
AI_TAGGING_MODEL=gpt-5.6-sol
AI_TAGGING_API_KEY=
AI_CONFIG_ENCRYPTION_KEY=replace-with-a-random-32-character-secret

WEB_PORT=8088
MINIO_PORT=19001
API_IMAGE=ghcr.io/zuixi01/tuxiangshibie-api:<git-sha>
