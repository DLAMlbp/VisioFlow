APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175
API_KEY=
INTEGRATION_API_KEY=
INTEGRATION_MAX_FILES=50
CALLBACK_TIMEOUT_SECONDS=15
CALLBACK_MAX_ATTEMPTS=5
CALLBACK_RETRY_BASE_SECONDS=5
CALLBACK_RECOVERY_INTERVAL_SECONDS=5
CALLBACK_DELIVERY_LEASE_SECONDS=120
CALLBACK_RECOVERY_BATCH_SIZE=100

DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/image_ai

REDIS_URL=redis://redis:6379/0

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:19000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=image-ai
S3_REGION=us-east-1
S3_PRESIGN_EXPIRES_SECONDS=900

INFERENCE_DEVICE=auto
INFERENCE_CPU_THREADS=4

MAX_IMAGES_PER_JOB=500
MAX_UPLOAD_BATCH_SIZE=500
UPLOAD_BATCH_EXPIRY_HOURS=24
UPLOAD_BATCH_PRESIGN_EXPIRES_SECONDS=3600
JOB_DISPATCH_CHUNK_SIZE=25
MAX_IMAGE_SIZE_MB=25

THUMBNAIL_LONG_SIDE=768
HARD_FILTER_MAX_WIDTH=10000
HARD_FILTER_MAX_HEIGHT=10000
TECHNICAL_DUPLICATE_HAMMING_DISTANCE=5
QUALITY_SHARPNESS_REFERENCE=250.0
QUALITY_CONTRAST_MIN_STDDEV=10.0
QUALITY_CONTRAST_MAX_STDDEV=64.0
QUALITY_EXPOSURE_BRIGHTNESS_PENALTY=25.0
QUALITY_EXPOSURE_CLIPPING_PENALTY=45.0
QUALITY_NOISE_PENALTY=1.5

PROFILES_DIRECTORY=profiles

DEFAULT_FILTER_PROFILE=renovation_submission_v1
DEFAULT_BEAUTIFY_PROFILE=renovation_natural_v1

IMAGE_RETENTION_DAYS=30
CLEANUP_INTERVAL_SECONDS=3600
PIPELINE_RECOVERY_INTERVAL_SECONDS=300
PIPELINE_STALE_SECONDS=900

# AI content tags are generated after natural enhancement. Set the API key in the server environment only.
AI_TAGGING_ENABLED=true
AI_TAGGING_PROVIDER=openai
AI_TAGGING_BASE_URL=https://router.keenlight.ai/v1
AI_TAGGING_MODEL=gpt-5.6-sol
AI_TAGGING_API_KEY=
AI_TAGGING_TIMEOUT_SECONDS=30
AI_TAGGING_MAX_RETRIES=2
AI_TAGGING_IMAGE_LONG_SIDE=1024
AI_TAGGING_CONCURRENCY=4
AI_TAGGING_RATE_LIMIT_PER_MINUTE=24
AI_TAGGING_STORE_RAW_RESPONSE=false

# Reference-library matching. OpenCLIP weights are loaded by library and tagging workers.
IMAGE_EMBEDDING_MODEL=ViT-B-32
IMAGE_EMBEDDING_PRETRAINED=laion2b_s34b_b79k
IMAGE_EMBEDDING_VERSION=openclip_vit_b32_v1
DEFAULT_SIMILARITY_PROFILE=library_similarity_v1
